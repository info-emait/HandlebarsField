{
    "manifestVersion": 1,
    "id": "#{Id}#",
    "version": "#{Version}#",
    "name": "Handlebars Field",
    "description": "#{Description}#",
    "publisher": "#{Publisher}#",
    "public": true,
    "categories": [
        "Azure Boards"
    ], 
    "targets": [{
        "id": "Microsoft.VisualStudio.Services"
    }],
    "icons": {
        "default": "img/logo.png"
    },
    "screenshots": [{
        "path": "img/screenshot1.gif"
    }, {
        "path": "img/screenshot2.png"
    }],
    "tags": [
        "wit", "work item", "roll up", "field", "handlebars", "template", "summary", "control", "form", "input"
    ],
    "links": {
        "support": {
            "uri": "mailto:info.emait@gmail.com"
        }
    },
    "repository": {
        "type": "git",
        "uri": "https://github.com/info-emait/HandlebarsField"
    },
    "content": {
        "details": {
            "path": "Overview.md"
        },
        "license": {
            "path": "License.md"
        }
    },
    "branding": {
        "color": "#212121",
        "theme": "dark"
    },
    "contributions": [{
        "id": "#{Id}#-control",
        "type": "ms.vss-work-web.work-item-form-control",
        "description": "TODO.",
        "targets": [
            "ms.vss-work-web.work-item-form"
        ],
        "properties": {
            "registeredObjectId": "#{Id}#-control",
            "name": "Handlebars Field",
            "description": "TODO.",
            "previewImageUrl": "img/preview.png",
            "uri": "control.html?v=#{Version}#",
            "height": 23,
            "inputs": [{
                "id": "field",
                "name": "Field name:",
                "description": "Name of the work item property whose value will be stored in the 'value' attribute when the template is applied.",
                "type": "WorkItemField",
                "properties": {
                    "workItemFieldTypes": [ "String", "Integer", "Double", "PlainText", "DateTime" ]
                },
                "validation": {
                    "dataType": "String",
                    "isRequired": true
                }
            }, {
                "id": "template",
                "name": "Template:",
                "description": "Handlebars.js template rendered using a model containing the properties: 'user' (current user information), 'wit' (complete current work item information), and 'value' (the value of the field specified in Field name).",
                "inputMode": "TextArea",
                "validation": {
                    "dataType": "String",
                    "isRequired": true
                }
            }, {
                "id": "helpers",
                "name": "Helpers:",
                "description": "Comma-separated list of functions that will be used as helper functions when applying the template: uppercase: (text) => text.toUpperCase(), truncate: (text, len) => text.substring(0, len).",
                "inputMode": "TextArea",
                "validation": {
                    "dataType": "String",
                    "isRequired": false
                }
            }, {
                "id": "loadRelatedWits",
                "name": "Load related work items:",
                "description": "If set to 'true', all related work items will be loaded, and can be accessed in the template via the 'wit.relations' property.",
                "validation": {
                    "dataType": "Boolean",
                    "isRequired": false
                }
            }, {
                "id": "loadingMessage",
                "name": "Loading message:",
                "description": "Message showed during data loading. The default value is '... loading'.",
                "validation": {
                    "dataType": "String",
                    "isRequired": false
                }
            }]
        }
    }],
    "files": [
        { "path": "control.html", "addressable": true },
        { "path": "img", "addressable": true },
        { "path": "assets", "addressable": true }
    ],
    "scopes":[
        "vso.work",
        "vso.work_write"
    ]
}
